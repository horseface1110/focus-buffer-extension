{
  "manifest_version": 3,
  "name": "分心緩衝器",
  "description": "在打開容易分心的網站前，先給自己一個喝水、伸展、回到待辦的緩衝。",
  "version": "0.2.0",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "分心緩衝器",
    "default_popup": "popup.html"
  },
  "options_page": "popup.html",
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "27.0"
    }
  }
}
